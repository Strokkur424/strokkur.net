---
import { TabItem, Tabs, Code } from "@astrojs/starlight/components";
import { LATEST_COMMANDS_RELEASE } from "../utils/versions.ts";

interface Props {
  project: string;
  annotations?: string;
  processor?: string;
}

const { project, annotations, processor } = Astro.props;

const annotationsModule = `annotations-${annotations ? annotations : project}`;
const processorModule = `processor-${processor ? processor : project}`;

const gradleRepository = `repositories {
  maven {
    id = "eldonexus"
    url = "https://eldonexus.de/repository/maven-public/"
  }
}`;
const gradleDependency = `dependencies {
  compileOnly("net.strokkur.commands:${annotationsModule}:${LATEST_COMMANDS_RELEASE}")
  annotationProcessor("net.strokkur.commands:${processorModule}:${LATEST_COMMANDS_RELEASE}")
}`;

const mavenRepository = `<repositories>
  <repository>
    <id>eldonexus</id>
    <url>https://eldonexus.de/repository/maven-public/</url>
  </repository>
</repositories>`;
const mavenAnnotationDependency = `<dependencies>
  <dependency>
    <groupId>net.strokkur.commands</groupId>
    <artifactId>${annotationsModule}</artifactId>
    <version>${LATEST_COMMANDS_RELEASE}</version>
    <scope>provided</scope>
  </dependency>
</dependencies>`;
const mavenProcessorDependency = `<pluginManagement>
  <plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-compiler-plugin</artifactId>
      <version>3.6.1</version>
      <configuration>
        <annotationProcessorPaths>
          <!-- Add annotation processor -->
          <annotationProcessorPath>
            <groupId>net.strokkur.commands</groupId>
            <artifactId>${processorModule}</artifactId>
            <version>${LATEST_COMMANDS_RELEASE}</version>
          </annotationProcessorPath>
        </annotationProcessorPaths>
      </configuration>
    </plugin>
  </plugins>
</pluginManagement>`;
---

<p>
  This separation is made with a very specific purpose in mind: To include only the most necessary classes in your
  project classpath. Since the <code>processor</code> module only contains classes related to internal logic (which may have
  similar names as Brigadier itself), having them included in the classpath would make the development experience very annoying.
</p>

<p>
  Therefore, adding the dependency would look like this, depending on your build-system. The versions here are
  automatically fetched and thus always up to date.
</p>

<Tabs syncKey="build-system">
  <TabItem label="Gradle">
    <p>First, add the repository:</p>

    <Code lang="kts" code={gradleRepository} />

    <p>
      Then add the annotations module as a <code>compileOnly</code> and the processor module as a
      <code>annotationProcessor</code> dependency.
    </p>

    <Code lang="kts" code={gradleDependency} />
  </TabItem>
  <TabItem label="Maven">
    <p>First, add the repository:</p>

    <Code lang="xml" code={mavenRepository} />

    <p>
      Then add the annotation module as a dependency, with scope <code>provided</code> so that the annotations do not get
      included in the output jar.
    </p>

    <Code lang="xml" code={mavenAnnotationDependency} />

    <p>Finally, we modify the compiler plugin and add a new annotation processor path for our processor module.</p>

    <Code lang="xml" code={mavenProcessorDependency} />
  </TabItem>
</Tabs>
